# ---------------------------------------------------------------------------
# Client. Vite compiles anything prefixed VITE_ into the public bundle — that
# is by design for these two: row-level security, not secrecy, is what protects
# the data. Set them in Vercel and in a local .env.local.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=

# Publishable key, sb_publishable_... VITE_SUPABASE_ANON_KEY is accepted as a
# fallback for the legacy anon JWT.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave both empty to run against local IndexedDB with no accounts, which is
# how the browser test suite runs.

# ---------------------------------------------------------------------------
# Server-only: the functions in api/ (billing). Never put any of these in a
# VITE_ variable. `npm run dev` passes them to api/ without bundling them.
# Which Vercel environments need which: docs/BILLING.md §5.
# ---------------------------------------------------------------------------

# Same value as VITE_SUPABASE_URL. The secret key bypasses RLS; the webhook
# uses it to write billing columns no user can.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe, test mode (sk_test_...) until launch.
STRIPE_SECRET_KEY=
# Locally: the whsec_... printed by `stripe listen`. Deployed: the Dashboard
# endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=
# price_... ids of the $2/month and $12/year prices.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
