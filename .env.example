# ---------------------------------------------------------------------------
# Server-only. Set these in Vercel (Settings -> Environment Variables) and in a
# local .env.local. They are never sent to the browser.
# ---------------------------------------------------------------------------

# The shared passcode. One for everyone; there are no accounts.
APP_PASSCODE=

# Signs the session cookie. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key (Project Settings -> API). Bypasses RLS, so every write in
# the app goes through the functions in api/. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Client. Vite compiles anything prefixed VITE_ into the public bundle — that
# is by design for these two. The bundle itself sits behind the passcode gate,
# and RLS limits the anon key to reading.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave both VITE_ values empty to run against local IndexedDB instead, which
# is how `npm run dev` and the Playwright suite work without a project.
